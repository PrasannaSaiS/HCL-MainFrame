       IDENTIFICATION DIVISION.
       PROGRAM-ID. BANK-STATEMENT.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 ACCOUNT-NUMBER PIC 9(5) VALUE 10001.
       01 ACCOUNT-NAME PIC X(20) VALUE "RAMESH KUMAR".
       01 OPENING-BALANCE PIC 9(7)V99 VALUE 25000.
       01 DEPOSIT-AMOUNT PIC 9(7)V99 VALUE 5000.
       01 WITHDRAWAL-AMOUNT PIC 9(7)V99 VALUE 1500.
       01 CLOSING-BALANCE PIC 9(7)V99 VALUE 0.
       PROCEDURE DIVISION.
           COMPUTE CLOSING-BALANCE =
               OPENING-BALANCE + DEPOSIT-AMOUNT.
           IF WITHDRAWAL-AMOUNT <= CLOSING-BALANCE
               SUBTRACT WITHDRAWAL-AMOUNT FROM CLOSING-BALANCE
               DISPLAY "WITHDRAWAL COMPLETED"
           ELSE
               DISPLAY "INSUFFICIENT BALANCE"
           END-IF.
           DISPLAY "BANK ACCOUNT STATEMENT".
           DISPLAY "ACCOUNT NUMBER: " ACCOUNT-NUMBER.
           DISPLAY "ACCOUNT NAME: " ACCOUNT-NAME.
           DISPLAY "OPENING BALANCE: " OPENING-BALANCE.
           DISPLAY "DEPOSIT: " DEPOSIT-AMOUNT.
           DISPLAY "WITHDRAWAL: " WITHDRAWAL-AMOUNT.
           DISPLAY "CLOSING BALANCE: " CLOSING-BALANCE.
           STOP RUN.
