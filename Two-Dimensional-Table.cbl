       IDENTIFICATION DIVISION.
       PROGRAM-ID. TWO-DIMENSIONAL-TABLE.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 SALES-TABLE.
          05 REGION OCCURS 3 TIMES.
             10 QUARTER-SALES PIC 9(5) OCCURS 4 TIMES.
       01 REGION-NUMBER PIC 9 VALUE 0.
       01 QUARTER-NUMBER PIC 9 VALUE 0.
       01 REGION-TOTAL PIC 9(6) VALUE 0.
       01 GRAND-TOTAL PIC 9(7) VALUE 0.
       PROCEDURE DIVISION.
           PERFORM VARYING REGION-NUMBER FROM 1 BY 1
               UNTIL REGION-NUMBER > 3
               PERFORM VARYING QUARTER-NUMBER FROM 1 BY 1
                   UNTIL QUARTER-NUMBER > 4
                   COMPUTE QUARTER-SALES(REGION-NUMBER,
                       QUARTER-NUMBER) =
                       REGION-NUMBER * 10000 + QUARTER-NUMBER * 2500
               END-PERFORM
           END-PERFORM.
           PERFORM VARYING REGION-NUMBER FROM 1 BY 1
               UNTIL REGION-NUMBER > 3
               MOVE 0 TO REGION-TOTAL
               PERFORM VARYING QUARTER-NUMBER FROM 1 BY 1
                   UNTIL QUARTER-NUMBER > 4
                   ADD QUARTER-SALES(REGION-NUMBER, QUARTER-NUMBER)
                       TO REGION-TOTAL
               END-PERFORM
               DISPLAY "REGION " REGION-NUMBER
                       " TOTAL: " REGION-TOTAL
               ADD REGION-TOTAL TO GRAND-TOTAL
           END-PERFORM.
           DISPLAY "GRAND TOTAL: " GRAND-TOTAL.
           STOP RUN.
