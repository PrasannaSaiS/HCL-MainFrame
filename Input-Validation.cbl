       IDENTIFICATION DIVISION.
       PROGRAM-ID. INPUT-VALIDATION.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 ACCOUNT-NUMBER PIC X(6) VALUE "100123".
       01 TRANSACTION-TYPE PIC X VALUE "D".
       01 TRANSACTION-AMOUNT PIC X(7) VALUE "0005000".
       PROCEDURE DIVISION.
           IF ACCOUNT-NUMBER IS NUMERIC
               DISPLAY "ACCOUNT NUMBER IS VALID"
           ELSE
               DISPLAY "ACCOUNT NUMBER MUST BE NUMERIC"
           END-IF.
           IF TRANSACTION-TYPE = "D"
               OR TRANSACTION-TYPE = "W"
               DISPLAY "TRANSACTION TYPE IS VALID"
           ELSE
               DISPLAY "INVALID TRANSACTION TYPE"
           END-IF.
           IF TRANSACTION-AMOUNT IS NUMERIC
               IF TRANSACTION-AMOUNT > "0000000"
                   DISPLAY "AMOUNT IS VALID"
               ELSE
                   DISPLAY "AMOUNT MUST BE GREATER THAN ZERO"
               END-IF
           ELSE
               DISPLAY "AMOUNT MUST BE NUMERIC"
           END-IF.
           STOP RUN.
