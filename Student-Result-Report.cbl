       IDENTIFICATION DIVISION.
       PROGRAM-ID. STUDENT-RESULT-REPORT.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT STUDENT-FILE ASSIGN TO "STUDENTS.DAT"
               ORGANIZATION IS LINE SEQUENTIAL.
           SELECT REPORT-FILE ASSIGN TO "RESULT.RPT"
               ORGANIZATION IS LINE SEQUENTIAL.
       DATA DIVISION.
       FILE SECTION.
       FD STUDENT-FILE.
       01 STUDENT-RECORD.
          05 STUDENT-ID PIC 9(4).
          05 STUDENT-NAME PIC X(15).
          05 STUDENT-MARKS PIC 999.
       FD REPORT-FILE.
       01 REPORT-LINE PIC X(60).
       WORKING-STORAGE SECTION.
       01 END-FLAG PIC X VALUE "N".
       01 STUDENT-COUNT PIC 99 VALUE 0.
       01 PASS-COUNT PIC 99 VALUE 0.
       01 FAIL-COUNT PIC 99 VALUE 0.
       01 TOTAL-MARKS PIC 9(5) VALUE 0.
       01 AVERAGE-MARKS PIC 999V99 VALUE 0.
       01 GRADE-VALUE PIC X.
       01 RESULT-VALUE PIC X(4).
       01 DETAIL-LINE.
          05 DETAIL-ID PIC 9(4).
          05 FILLER PIC X VALUE SPACE.
          05 DETAIL-NAME PIC X(15).
          05 FILLER PIC X VALUE SPACE.
          05 DETAIL-MARKS PIC 999.
          05 FILLER PIC X VALUE SPACE.
          05 DETAIL-GRADE PIC X.
          05 FILLER PIC X VALUE SPACE.
          05 DETAIL-RESULT PIC X(4).
       PROCEDURE DIVISION.
           OPEN INPUT STUDENT-FILE OUTPUT REPORT-FILE.
           MOVE "ID   NAME             MARKS GRADE RESULT"
               TO REPORT-LINE.
           WRITE REPORT-LINE.
           PERFORM READ-NEXT-RECORD.
           PERFORM UNTIL END-FLAG = "Y"
               PERFORM PROCESS-STUDENT
               PERFORM READ-NEXT-RECORD
           END-PERFORM.
           IF STUDENT-COUNT > 0
               COMPUTE AVERAGE-MARKS = TOTAL-MARKS / STUDENT-COUNT
           END-IF.
           CLOSE STUDENT-FILE REPORT-FILE.
           DISPLAY "STUDENTS PROCESSED: " STUDENT-COUNT.
           DISPLAY "PASSED: " PASS-COUNT.
           DISPLAY "FAILED: " FAIL-COUNT.
           DISPLAY "AVERAGE MARKS: " AVERAGE-MARKS.
           DISPLAY "REPORT CREATED: RESULT.RPT".
           STOP RUN.
       READ-NEXT-RECORD.
           READ STUDENT-FILE
               AT END MOVE "Y" TO END-FLAG
           END-READ.
       PROCESS-STUDENT.
           EVALUATE TRUE
               WHEN STUDENT-MARKS >= 90 MOVE "A" TO GRADE-VALUE
               WHEN STUDENT-MARKS >= 75 MOVE "B" TO GRADE-VALUE
               WHEN STUDENT-MARKS >= 60 MOVE "C" TO GRADE-VALUE
               WHEN STUDENT-MARKS >= 40 MOVE "D" TO GRADE-VALUE
               WHEN OTHER MOVE "F" TO GRADE-VALUE
           END-EVALUATE.
           IF STUDENT-MARKS >= 40
               MOVE "PASS" TO RESULT-VALUE
               ADD 1 TO PASS-COUNT
           ELSE
               MOVE "FAIL" TO RESULT-VALUE
               ADD 1 TO FAIL-COUNT
           END-IF.
           ADD 1 TO STUDENT-COUNT.
           ADD STUDENT-MARKS TO TOTAL-MARKS.
           MOVE STUDENT-ID TO DETAIL-ID.
           MOVE STUDENT-NAME TO DETAIL-NAME.
           MOVE STUDENT-MARKS TO DETAIL-MARKS.
           MOVE GRADE-VALUE TO DETAIL-GRADE.
           MOVE RESULT-VALUE TO DETAIL-RESULT.
           WRITE REPORT-LINE FROM DETAIL-LINE.
